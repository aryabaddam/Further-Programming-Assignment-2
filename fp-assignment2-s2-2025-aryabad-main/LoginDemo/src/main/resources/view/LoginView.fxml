<?xml version="1.0" encoding="UTF-8"?>

<!-- This code defines the login interface for users. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<!-- This code structures the layout of the login form. -->
<GridPane alignment="CENTER" cache="true" hgap="10.0" maxHeight="300.0" maxWidth="500.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="500.0" vgap="10.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
  <!-- This code defines column sizing for alignment. -->
  <columnConstraints>
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
  </columnConstraints>
  <!-- This code defines row sizing for alignment. -->
  <rowConstraints>
    <RowConstraints />
    <RowConstraints />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
  </rowConstraints>
   <!-- This section contains all input fields, labels, and buttons. -->
   <children>
      <!-- This code labels the input fields. -->
      <Label contentDisplay="CENTER" graphicTextGap="0.0" text="User name" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS" />
      <!-- This code labels the input fields. -->
      <Label contentDisplay="CENTER" graphicTextGap="0.0" text="Password" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS" />
      <!-- This code provides input areas for username and password. -->
      <TextField fx:id="name" maxHeight="26.0" maxWidth="1.7976931348623157E308" prefHeight="26.0" prefWidth="159.0" promptText="Please enter your user name" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="CENTER" GridPane.vgrow="ALWAYS" />
      <PasswordField fx:id="password" promptText="Please enter your password" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <!-- This code creates the login button. -->
      <Button fx:id="login" contentDisplay="CENTER" maxHeight="30.0" maxWidth="60.0" mnemonicParsing="false" text="Login" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS" />
      <!-- This code displays feedback or error messages. -->
      <Label fx:id="message" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.hgrow="NEVER" GridPane.valignment="CENTER" GridPane.vgrow="NEVER" />
      <!-- This code allows navigation to the signup page. -->
      <Button fx:id="signup" contentDisplay="CENTER" maxHeight="30.0" maxWidth="60.0" mnemonicParsing="false" text="Signup" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" GridPane.vgrow="ALWAYS" />
   </children>
   <!-- This code adds spacing around the login form for clean UI design. -->
   <padding>
      <Insets bottom="60.0" right="80.0" top="50.0" />
   </padding>
</GridPane>
