<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.HomeController"
      alignment="CENTER"
      spacing="10"
      prefHeight="500"
      prefWidth="600">

    <children>
        <!-- Welcome Label -->
        <Label fx:id="welcomeLabel"
               text="Welcome!"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <!-- Menu Bar -->
        <MenuBar fx:id="menu" VBox.vgrow="NEVER" maxWidth="Infinity">
            <menus>
                <Menu fx:id="profile" text="Profile">
                    <items>
                        <MenuItem fx:id="viewProfile" text="View my profile"/>
                        <MenuItem fx:id="updateProfile" text="Update my profile"/>
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <!-- Projects Table -->
        <TableView fx:id="projectsTable" prefWidth="550" prefHeight="350">
            <placeholder>
                <Label text="No projects available"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="120"/>
                <TableColumn fx:id="locationColumn" text="Location" prefWidth="120"/>
                <TableColumn fx:id="dayColumn" text="Day" prefWidth="80"/>
                <TableColumn fx:id="hourlyValueColumn" text="Hourly Rate" prefWidth="100"/>
                <TableColumn fx:id="slotsColumn" text="Slots" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER">
            <children>
                <Button fx:id="addToCartButton" text="Add to Cart" prefWidth="120"/>
                <Button fx:id="viewCartButton" text="View Cart" prefWidth="120"/>
            </children>
        </HBox>

        <!-- Status Label -->
        <Label fx:id="statusLabel" textFill="blue"/>
    </children>

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>