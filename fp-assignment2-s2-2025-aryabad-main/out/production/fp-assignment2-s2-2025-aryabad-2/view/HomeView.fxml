<?xml version="1.0" encoding="UTF-8"?>

<!-- This code defines the main dashboard layout for the application. -->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@style.css"
      spacing="10"
      alignment="CENTER"
      prefWidth="800" prefHeight="600">

    <!-- This code creates the navigation bar for user profile actions. -->
    <MenuBar fx:id="menuBar" VBox.vgrow="NEVER">
        <menus>
            <!-- This code defines the Profile menu options (view, update, logout). -->
            <Menu text="Profile">
                <items>
                    <MenuItem fx:id="viewProfile" text="View Profile"/>
                    <MenuItem fx:id="updateProfile" text="Update Profile"/>
                    <MenuItem fx:id="logout" text="Logout"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <!-- This code displays the welcome message to the logged-in user. -->
    <Label fx:id="welcomeLabel"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"
           text="Welcome to" />

    <!-- This code displays the app title. -->
    <Label text="VolunTrack!!!" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

    <!-- This code displays a list of available projects in a table format. -->
    <TableView fx:id="projectsTable" prefWidth="700" prefHeight="400">
        <columns>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="150"/>
            <TableColumn fx:id="locationColumn" text="Location" prefWidth="150"/>
            <TableColumn fx:id="dayColumn" text="Day" prefWidth="100"/>
            <TableColumn fx:id="hourlyValueColumn" text="Hourly Value" prefWidth="120"/>
            <TableColumn fx:id="slotsColumn" text="Slots" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- This code contains the input field for volunteer hours and buttons for cart management. -->
    <HBox alignment="CENTER" spacing="15">
        <children>
            <Label text="Volunteer Hours:" />
            <TextField fx:id="hoursField" promptText="1-3" prefWidth="60"/>
            <Button fx:id="addToCartButton" text="Add to Cart" prefWidth="120"/>
            <Button fx:id="viewCartButton" text="View Cart" prefWidth="120"/>
        </children>
    </HBox>

    <!-- This code displays system messages or status feedback. -->
    <Label fx:id="statusLabel" textFill="red" />

    <!-- This code defines spacing around the entire dashboard layout. -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</VBox>